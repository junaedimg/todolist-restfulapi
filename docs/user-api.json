{
    "openapi": "3.1.1",
    "info": {
        "title": "User API",
        "version": "1.0",
        "description": "API untuk manajemen user (register, login, logout, profile)"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Development"
        }
    ],
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "RegisterRequest": {
                "type": "object",
                "required": ["name", "username", "email", "password"],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nama lengkap user",
                        "example": "Jojo Bizarre"
                    },
                    "username": {
                        "type": "string",
                        "description": "Username untuk login",
                        "example": "jojobizarre"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Alamat email untuk login",
                        "example": "jojo@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "description": "Password minimal 8 karakter",
                        "example": "rahasia123"
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "required": ["login", "password"],
                "properties": {
                    "login": {
                        "type": "string",
                        "description": "Username atau email",
                        "example": "jojobizarre"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "description": "Password user",
                        "example": "rahasia123"
                    }
                }
            },
            "UpdateUserRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nama lengkap user",
                        "example": "Jojo Bizarre Updated"
                    },
                    "username": {
                        "type": "string",
                        "description": "Username baru",
                        "example": "jojobizarre2"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Email baru",
                        "example": "jojo2@example.com"
                    }
                }
            },
            "UserResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "ID user",
                        "example": 1
                    },
                    "username": {
                        "type": "string",
                        "description": "Username user",
                        "example": "jojobizarre"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "Email user",
                        "example": "jojo@example.com"
                    },
                    "name": {
                        "type": "string",
                        "description": "Nama lengkap user",
                        "example": "Jojo Bizarre"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Tanggal dibuat",
                        "example": "2026-07-18T12:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Tanggal diperbarui",
                        "example": "2026-07-18T12:00:00Z"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "errors": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "string",
                                "example": "Unauthorized"
                            }
                        }
                    }
                }
            },
            "ValidationErrorResponse": {
                "type": "object",
                "properties": {
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "security": [
        {
            "BearerAuth": []
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "operationId": "registerUser",
                "summary": "Registrasi user baru",
                "description": "Mendaftarkan user baru dengan name, username, email, dan password",
                "tags": ["User"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registrasi berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/login": {
            "post": {
                "operationId": "userLogin",
                "summary": "Login user",
                "description": "Login menggunakan username atau email + password",
                "tags": ["User"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "token": {
                                                    "type": "string",
                                                    "description": "Bearer token",
                                                    "example": "1|abc123def456..."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Username/email atau password salah",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/api/users/logout": {
            "post": {
                "operationId": "userLogout",
                "summary": "Logout user",
                "description": "Menghapus token saat ini (logout)",
                "tags": ["User"],
                "responses": {
                    "200": {
                        "description": "Logout berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string",
                                                    "example": "Logout success"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/users/current": {
            "get": {
                "operationId": "getCurrentUser",
                "summary": "Mendapatkan data user saat ini",
                "description": "Mengembalikan profile user yang sedang login",
                "tags": ["User"],
                "responses": {
                    "200": {
                        "description": "Data user ditemukan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "operationId": "updateCurrentUser",
                "summary": "Update profile user saat ini",
                "description": "Memperbarui name, username, atau email user yang sedang login",
                "tags": ["User"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile berhasil diperbarui",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/UserResponse"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
